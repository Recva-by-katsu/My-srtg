# =============================================================================
#  Katsu R2 Manager - contoh environment variables
# =============================================================================
#  Berkas ini adalah REFERENSI. Anda tidak perlu menjalankannya di terminal.
#
#  Di mana mengisinya:
#   * Cloudflare : Workers & Pages -> proyek Anda -> Settings -> Variables and
#                  Secrets (pilih tipe "Secret" untuk nilai rahasia) -> Deploy ulang
#   * Vercel     : Project -> Settings -> Environment Variables (Production,
#                  Preview, Development) -> Redeploy
#   * Pengembangan lokal (opsional): salin berkas ini menjadi `.env.local`
#
#  Semua nilai rahasia bisa dibuat dari browser lewat halaman /setup
#  (Setup Assistant) - hash password, SESSION_SECRET, dan
#  CREDENTIAL_ENCRYPTION_KEY dibuat di perangkat Anda dan tidak pernah dikirim
#  ke server.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ADMIN  (WAJIB)
# -----------------------------------------------------------------------------

# Username untuk login ke /admin
ADMIN_USERNAME=katsu

# Hash PBKDF2-SHA256 dari password admin.
# Buat lewat /setup -> langkah 2 -> "Buat hash".
# Format: pbkdf2-sha256$<iterations>$<salt-b64url>$<hash-b64url>
ADMIN_PASSWORD_HASH=

# Jumlah iterasi PBKDF2 yang dipakai saat membuat hash (harus sama dengan hash).
# Cloudflare Workers paket gratis punya batas CPU 10ms/request: bila login terasa
# lambat, turunkan ke 25000-50000 ATAU naikkan limits.cpu_ms di wrangler.jsonc.
PASSWORD_PBKDF2_ITERATIONS=100000

# Kunci penanda tangan cookie sesi (HMAC-SHA256), minimal 32 karakter acak.
# Buat lewat /setup -> langkah 3. Mengganti nilai ini mengeluarkan semua sesi.
SESSION_SECRET=

# Masa berlaku sesi admin dalam jam (default 12).
SESSION_TTL_HOURS=12

# Kunci enkripsi AES-256-GCM untuk Access Key & Secret Access Key R2.
# JANGAN diganti setelah ada storage yang tersimpan.
CREDENTIAL_ENCRYPTION_KEY=

# Nama cookie (jarang perlu diubah)
SESSION_COOKIE_NAME=katsu_session
CSRF_COOKIE_NAME=katsu_csrf


# -----------------------------------------------------------------------------
# 2. DATABASE  (WAJIB: pilih D1 atau KV)
# -----------------------------------------------------------------------------
#  Aplikasi berbicara ke Cloudflare lewat HTTP API resmi, jadi CLOUDFLARE_ACCOUNT_ID
#  dan CLOUDFLARE_API_TOKEN wajib diisi untuk D1 maupun KV. Keuntungannya: kode
#  yang sama jalan di Cloudflare Workers/Pages maupun di Vercel.

# d1 (disarankan) | kv | memory
DATABASE_DRIVER=d1

# Cloudflare Dashboard -> Storage & Databases -> D1 -> database Anda -> "Database ID"
DATABASE_ID=

# Cloudflare Dashboard -> Workers & Pages -> KV -> namespace Anda -> "Namespace ID"
# Dipakai bila DATABASE_DRIVER=kv
KV_NAMESPACE_ID=


# -----------------------------------------------------------------------------
# 3. CLOUDFLARE API  (WAJIB bila memakai D1 atau KV)
# -----------------------------------------------------------------------------

# Account ID (32 karakter heksadesimal).
# Lihat di dashboard Cloudflare: halaman overview akun, kolom kanan "Account ID".
CLOUDFLARE_ACCOUNT_ID=

# API Token dengan izin:
#   * Account -> D1 -> Edit      (bila DATABASE_DRIVER=d1)
#   * Account -> Workers KV -> Edit (bila DATABASE_DRIVER=kv)
# Buat lewat My Profile -> API Tokens -> Create Token -> Custom token.
# Token ini TIDAK butuh izin R2: kredensial tiap bucket R2 diisi lewat dashboard admin.
CLOUDFLARE_API_TOKEN=

# Jarang perlu diubah
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4


# -----------------------------------------------------------------------------
# 4. APLIKASI
# -----------------------------------------------------------------------------

# URL publik aplikasi (dipakai untuk tautan absolut & metadata Open Graph).
APP_URL=https://download.domain-anda.com

# Nama aplikasi yang tampil di header dan metadata.
APP_NAME=Katsu R2 Manager

# Mode demo: menampilkan data contoh tanpa menghubungi R2 (untuk mencoba UI).
DEMO_MODE=false

# Level log: debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 5. UPLOAD (multipart langsung dari browser ke R2)
# -----------------------------------------------------------------------------

# Prefiks object key di dalam bucket, misalnya files -> files/2026/09/<id>/<nama>
STORAGE_OBJECT_PREFIX=files

# Ukuran bagian default dalam MB (minimum 5 MB sesuai aturan S3/R2).
DEFAULT_PART_SIZE_MB=8

# Batas ukuran file per upload dalam GB.
MAX_UPLOAD_SIZE_GB=20

# Jumlah bagian yang diunggah paralel per file (1-8).
MAX_CONCURRENT_PARTS=3

# Object key file uji yang dipakai tombol "Tes koneksi" (dibuat lalu dihapus).
STORAGE_PROBE_KEY=.katsu/connection-probe.txt


# -----------------------------------------------------------------------------
# 6. DOWNLOAD
# -----------------------------------------------------------------------------

# stream  : aplikasi meneruskan byte dari R2 (default, paling mudah)
# redirect: aplikasi memberi URL pre-signed R2 berumur pendek
# worker  : aplikasi mengalihkan ke worker mandiri (lihat workers/download-worker.ts)
DOWNLOAD_MODE=stream

# URL worker mandiri. Wajib bila DOWNLOAD_MODE=worker.
DOWNLOAD_WORKER_URL=

# Kunci penanda tangan tautan unduhan sementara. Bila kosong, SESSION_SECRET dipakai.
DOWNLOAD_SIGNING_SECRET=

# Masa berlaku tautan unduhan bertanda tangan (detik, default 6 jam).
DOWNLOAD_LINK_TTL_SECONDS=21600

# Tampilkan daftar file publik di halaman utama (/). Matikan untuk mode privat.
PUBLIC_LISTING=true

# Buka file di browser (inline) alih-alih mengunduhnya. Default: selalu attachment.
DOWNLOAD_INLINE_CONTENT_TYPES=false


# -----------------------------------------------------------------------------
# 7. RATE LIMITING  (opsional, default sudah aman)
# -----------------------------------------------------------------------------

RATE_LIMIT_LOGIN_ATTEMPTS=6
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_API_REQUESTS=240
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_DOWNLOAD_REQUESTS=120
RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=60
